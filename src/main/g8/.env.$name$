# .env.$name$
#
# These variables are read by src/main/resources/application.conf (and by the provider modules'
# own reference.conf), which is where the LLM4S named-provider configuration lives. Nothing in
# the application code reads the environment directly - configuration goes through `Llm4sConfig`.
#
# Load with:  set -a; . ./.env.$name$; set +a

# Which named section under llm4s.providers to use. Defaults to ollama-local (no key needed).
# LLM4S_PROVIDER=openai-main

# Ollama (the default): override the model or the server.
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434

# OpenAI: llm4s-openai binds this to llm4s.credentials.openai.apiKey for the openai-main section.
# OPENAI_API_KEY=your-openai-key-here
# OPENAI_MODEL=gpt-4o-mini

# Other vendors are read the same way once their module is in build.sbt:
# ANTHROPIC_API_KEY=your-anthropic-key-here   # llm4s-anthropic
# GOOGLE_API_KEY=your-google-key-here         # llm4s-gemini
