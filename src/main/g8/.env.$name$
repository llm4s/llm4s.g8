# .env.$name$
#
# These variables are read by src/main/resources/application.conf, which is where the LLM4S
# named-provider configuration lives. Nothing in the application code reads the environment
# directly — configuration goes through `Llm4sConfig`.

# Which named provider under llm4s.providers to use (defaults to openai-main).
# LLM4S_PROVIDER=openai-main

# Credentials for the openai-main provider.
OPENAI_API_KEY=your-openai-key-here
# OPENAI_MODEL=gpt-4o

# Uncomment the matching provider block in application.conf before using these.
# ANTHROPIC_API_KEY=your-claude-key-here
